# macOS
.DS_Store

# Secret / môi trường — KHÔNG BAO GIỜ commit file thật
.env
.env.*
!.env.example
!.env.staging.example

# Node
node_modules/
dist/
coverage/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*

# Database cục bộ — không commit dữ liệu thật
*.sqlite3
*.sqlite3-journal
*.db

# Playwright
playwright-report/
test-results/
blob-report/
.playwright/

# Log
*.log

# Bản sao lưu database — chứa ĐẦY ĐỦ PII khách (tên, SĐT, công ty).
# TUYỆT ĐỐI không commit: bản dump không được hưởng quyền bảo vệ của database.
*.dump
*.dump.age
*.dump.sha256
pg-backup/

# Ảnh sản phẩm tải lên (kho lưu local) — dữ liệu, không phải mã nguồn
var/

# Log của scripts/owner_staging_run.sh (gửi cho harness, không vào Git).
staging-run-*/
