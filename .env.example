# ============================================================================
# VIP PHONE — mẫu biến môi trường
#
# Sao chép thành `.env` rồi điền giá trị thật. `.env` ĐÃ được .gitignore.
# TUYỆT ĐỐI KHÔNG commit secret thật vào repo.
# ============================================================================

# ----------------------------------------------------------------- môi trường
# dev | test | staging | production
APP_ENV=dev
LOG_LEVEL=INFO

# ------------------------------------------------------------------- dữ liệu
# Bắt buộc. PostgreSQL 16.
# Định dạng: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
# Thay <user>, <password>, <db> bằng giá trị thật của bạn.
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/<db>
SQL_ECHO=false

# -------------------------------------------------------- địa chỉ công khai
# Dùng để dựng URL trong mã QR. KHÔNG hard-code domain production trong mã nguồn.
# dev:     http://localhost:8000
# staging: https://staging.vipphone.example
PUBLIC_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------ gift code
# Để trống thì suy từ năm hiện tại (UTC). Đặt khi cần ghim tiền tố, ví dụ 26.
GIFT_CODE_YEAR_PREFIX=
GIFT_CODE_LENGTH=6
GIFT_CODE_MAX_ATTEMPTS=8

# ------------------------------------------------------- xác thực nhân viên
# Danh sách khoá API, phân tách bằng dấu phẩy.
# RỖNG = CHƯA CẤU HÌNH = các route nhân viên trả 503 (fail CLOSED).
#
# Sinh khoá mạnh:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# KHÔNG dùng giá trị mẫu dưới đây ở staging/production.
STAFF_API_KEYS=

# ------------------------------------------------------------- chống lạm dụng
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LEADS_PER_WINDOW=10
RATE_LIMIT_WINDOW_SECONDS=60
# CHỈ bật khi máy chủ THẬT SỰ nằm sau reverse proxy tin cậy.
TRUST_PROXY_HEADERS=false

# ------------------------------------------------------------------ turnstile
# Để trống = tắt kiểm tra chống spam. Lấy khoá tại Cloudflare dashboard.
# KHÔNG commit secret thật.
TURNSTILE_SECRET_KEY=
# Khoá SITE là khoá CÔNG KHAI (nằm trong HTML/JS) — không phải secret, nhưng vẫn
# không commit giá trị thật. Cần CẢ HAI khoá thì Turnstile mới chạy được.
# Xem docs/staging.md §3 để biết vì sao bật TURNSTILE_REQUIRED khi thiếu khoá sẽ
# CHẶN MỌI LEAD.
TURNSTILE_SITE_KEY=
TURNSTILE_REQUIRED=false

# ----------------------------------------------------------------------- CORS
# CỐ Ý KHÔNG CÓ CẤU HÌNH CORS.
# API và frontend phục vụ CÙNG ORIGIN nên CORS không cần thiết. Trước đây có
# CORS_ALLOWED_ORIGINS nhưng KHÔNG middleware nào dùng — cấu hình chết, đọc như
# đã làm mà thực ra chưa làm. Đã gỡ. Nếu sau này tách frontend sang origin khác
# thì phải gắn CORSMiddleware với allowlist TƯỜNG MINH và viết test cho nó.

# ---------------------------------------------------------------------- host
# Danh sách Host được phép, phân tách bằng dấu phẩy. RỖNG = KHÔNG giới hạn Host.
#
# ⚠️  Ở production PHẢI đặt giá trị thật, nếu không sẽ bị host-header injection.
#     Khi rỗng ở production, máy chủ ghi CẢNH BÁO lúc khởi động và /api/ready báo
#     "NOT_CONFIGURED" — cố ý ồn ào chứ không im lặng.
ALLOWED_HOSTS=

# ------------------------------------------------------------------ giới hạn
# Trần body của POST /api/leads. Kiểm bằng Content-Length TRƯỚC khi đọc body;
# body chunked đọc theo khối và bỏ ngay khi vượt trần.
MAX_LEAD_BODY_BYTES=8192

# ------------------------------------------------------------- readiness
# Có công khai chi tiết của /api/ready (migration head, turnstile, staff auth)
# cho người KHÔNG có khoá nhân viên hay không. Mặc định false.
# Bật true chỉ khi có lý do rõ ràng — chi tiết đó là thông tin trinh sát.
EXPOSE_READINESS_DETAILS=false
