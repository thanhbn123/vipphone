# ============================================================================
# VIP PHONE — mẫu biến môi trường
#
# Sao chép thành `.env` rồi điền giá trị thật. `.env` ĐÃ được .gitignore.
# TUYỆT ĐỐI KHÔNG commit secret thật vào repo.
# ============================================================================

# ----------------------------------------------------------------- môi trường
# dev | test | staging | production
APP_ENV=dev
LOG_LEVEL=INFO

# ------------------------------------------------------------------- dữ liệu
# Bắt buộc. PostgreSQL 16.
# Định dạng: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
# Thay <user>, <password>, <db> bằng giá trị thật của bạn.
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/<db>
SQL_ECHO=false

# -------------------------------------------------------- địa chỉ công khai
# Dùng để dựng URL trong mã QR. KHÔNG hard-code domain production trong mã nguồn.
# dev:     http://localhost:8000
# staging: https://staging.vipphone.example
PUBLIC_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------ gift code
# Để trống thì suy từ năm hiện tại (UTC). Đặt khi cần ghim tiền tố, ví dụ 26.
GIFT_CODE_YEAR_PREFIX=
GIFT_CODE_LENGTH=6
GIFT_CODE_MAX_ATTEMPTS=8

# ------------------------------------------------------- xác thực nhân viên
# Danh sách khoá API, phân tách bằng dấu phẩy.
# RỖNG = CHƯA CẤU HÌNH = các route nhân viên trả 503 (fail CLOSED).
#
# Sinh khoá mạnh:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# KHÔNG dùng giá trị mẫu dưới đây ở staging/production.
STAFF_API_KEYS=

# ------------------------------------------------------------- chống lạm dụng
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LEADS_PER_WINDOW=10
RATE_LIMIT_WINDOW_SECONDS=60
# CHỈ bật khi máy chủ THẬT SỰ nằm sau reverse proxy tin cậy.
TRUST_PROXY_HEADERS=false

# ------------------------------------------------------------------ turnstile
# Để trống = tắt kiểm tra chống spam. Lấy khoá tại Cloudflare dashboard.
# KHÔNG commit secret thật.
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=false

# ----------------------------------------------------------------------- CORS
# Để trống = không bật CORS (khuyến nghị vì API phục vụ cùng origin).
CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------------ giới hạn
MAX_LEAD_BODY_BYTES=8192
