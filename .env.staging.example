# ============================================================================
# VIP PHONE — mẫu biến môi trường cho STAGING
#
# Sao chép thành `.env` trên máy staging rồi điền giá trị thật.
# `.env` ĐÃ được .gitignore. TUYỆT ĐỐI KHÔNG commit secret thật.
#
# Phân loại đầy đủ từng biến (REQUIRED/OPTIONAL, SECRET/PUBLIC, BUILD-TIME/RUN-TIME)
# nằm ở `docs/staging.md`. File này chỉ là mẫu điền nhanh.
#
# Kiểm tra trước khi deploy:  scripts/staging_preflight.sh
# ============================================================================

# ----------------------------------------------------------------- môi trường
# REQUIRED · PUBLIC · RUN-TIME
APP_ENV=staging
LOG_LEVEL=INFO

# ------------------------------------------------------------------- dữ liệu
# REQUIRED · SECRET · RUN-TIME
# PostgreSQL 16. Staging PHẢI là database riêng, KHÔNG trỏ vào production.
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<db_staging>
SQL_ECHO=false

# -------------------------------------------------------- địa chỉ công khai
# REQUIRED · PUBLIC · RUN-TIME
# Dùng để dựng URL trong mã QR ⇒ phải là địa chỉ KHÁCH THẬT SỰ MỞ ĐƯỢC.
# Sai chỗ này thì QR in ra trỏ vào localhost và không ai quét được.
# PHẢI là https ở staging.
PUBLIC_BASE_URL=https://staging.<domain-cua-ban>

# ------------------------------------------------------- xác thực nhân viên
# REQUIRED · SECRET · RUN-TIME
# RỖNG = khu vực nhân viên ĐÓNG (503). Đây là fail-closed, không phải lỗi.
#
# Sinh khoá mạnh, MỘT khoá cho mỗi người/quầy:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# KHÔNG dùng lại khoá của dev/test. KHÔNG commit khoá thật.
STAFF_API_KEYS=

# ------------------------------------------------------------------ gift code
# OPTIONAL · PUBLIC · RUN-TIME
# Để trống thì suy từ năm hiện tại (UTC).
GIFT_CODE_YEAR_PREFIX=
GIFT_CODE_LENGTH=6
GIFT_CODE_MAX_ATTEMPTS=8

# ------------------------------------------------------------- chống lạm dụng
# OPTIONAL · PUBLIC · RUN-TIME
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LEADS_PER_WINDOW=10
RATE_LIMIT_WINDOW_SECONDS=60

# ⚠️  Staging ĐỨNG SAU reverse proxy ⇒ PHẢI đặt true, NHƯNG chỉ khi proxy đã
#     ghi đè X-Forwarded-For. Nếu bật mà proxy không ghi đè thì client tự đặt
#     header và né được rate limit.
TRUST_PROXY_HEADERS=true

# ---------------------------------------------------------------------- host
# REQUIRED · PUBLIC · RUN-TIME
# Danh sách Host được phép, phân tách bằng dấu phẩy. RỖNG = KHÔNG giới hạn Host.
# Ở staging/production PHẢI đặt, nếu không sẽ bị host-header injection.
ALLOWED_HOSTS=staging.<domain-cua-ban>

# ------------------------------------------------------------------ turnstile
# OPTIONAL · SECRET · RUN-TIME
# Lấy tại Cloudflare dashboard. Để trống = TẮT kiểm tra chống spam.
# ⚠️  Xem `docs/staging.md` mục "Bẫy Turnstile": bật TURNSTILE_REQUIRED=true khi
#     frontend CHƯA có widget sẽ CHẶN MỌI LEAD.
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=false

# OPTIONAL · PUBLIC · RUN-TIME
# Khoá site là khoá CÔNG KHAI (nằm trong HTML/JS) — không phải secret.
TURNSTILE_SITE_KEY=

# ------------------------------------------------------------------ giới hạn
# OPTIONAL · PUBLIC · RUN-TIME
MAX_LEAD_BODY_BYTES=8192

# ---------------------------------------------------------------- readiness
# OPTIONAL · PUBLIC · RUN-TIME
# Có công khai chi tiết /api/ready cho người KHÔNG có khoá nhân viên hay không.
# Staging: để false. Chi tiết đó là thông tin trinh sát.
EXPOSE_READINESS_DETAILS=false

# ============================================================================
# GHI CHÚ VỀ CORS
# CỐ Ý KHÔNG CÓ CẤU HÌNH CORS. API và frontend phục vụ CÙNG ORIGIN nên CORS
# không cần thiết. Nếu sau này tách frontend sang origin khác thì phải gắn
# CORSMiddleware với allowlist TƯỜNG MINH và viết test — không dùng `*`.
# ============================================================================
#
# GHI CHÚ VỀ "SESSION SIGNING SECRET"
# KHÔNG CÓ, VÀ KHÔNG CẦN. Stack này không dùng cookie/phiên: xác thực nhân viên
# là khoá API gửi qua header (`X-Staff-Key` hoặc `Authorization: Bearer`), so
# bằng `secrets.compare_digest`. Không có gì để ký. Nếu sau này thêm phiên
# cookie thì PHẢI thêm secret ký và ghi vào file này.
# ============================================================================
